generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String      @id @default(cuid())
  name                String?
  email               String?     @unique
  emailVerified       DateTime?
  image               String?
  /// Legacy (pre-Google) accounts only. Cleared once the account is claimed.
  deviceId            String?     @unique
  role                Role        @default(MEMBER)
  status              UserStatus  @default(PENDING)
  intention           String?
  theme               Theme       @default(LIGHT)
  onboardedAt         DateTime?
  approvedAt          DateTime?
  approvedById        String?
  /// What ana calls you in greetings (defaults to the first name).
  preferredName       String?
  /// Your own photo (private, served like any other media). Falls back to the Google picture.
  photoId             String?     @unique
  photo               Attachment? @relation("UserPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  birthday            DateTime?   @db.Date
  /// City or centre, in your words.
  place               String?
  /// "Who am I?" comes back every this many months (0 = never).
  portraitEveryMonths Int         @default(3)
  /// IANA time zone from the browser (e.g. "Asia/Kolkata"), so reminders arrive at a sensible hour.
  timeZone            String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @default(now()) @updatedAt

  accounts          Account[]
  sessions          Session[]
  features          UserFeature[]
  practices         Practice[]
  dayLogs           DayLog[]
  dailyReflections  DailyReflection[]
  weeklyReflections WeeklyReflection[]
  sevaEntries       SevaEntry[]
  expressions       Expression[]
  Person            Person[]
  Attachment        Attachment[]
  Commitment        Commitment[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  portraits         Portrait[]

  @@index([status])
}

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  SUSPENDED
}

/// Which features a user can reach. Feature definitions live in src/lib/features.ts.
/// A feature is available when the admin allows it AND the user has turned it on.
model UserFeature {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature     String
  allowed     Boolean  @default(true)
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([userId, feature])
}

// === Auth.js (Google sign-in) ===

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum Theme {
  DARK
  LIGHT
}

enum Tier {
  FIXED
  CUSTOM
}

model Practice {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  iconName      String
  /// Id in src/lib/practiceCatalog.ts for library practices; null for custom ones.
  catalogId     String?
  tier          Tier
  hasDoneToggle Boolean  @default(true)
  order         Int
  fields        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, order])
}

model DayLog {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  entries Json

  @@unique([userId, date])
}

model DailyReflection {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  answers Json
  stamps  Json
  moodKey String?

  @@unique([userId, date])
}

model WeeklyReflection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  answers   Json
  stamps    Json

  @@unique([userId, weekStart])
}

model SevaEntry {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  s1     String
  s2     String
  s3     String
}

/// A moment (formerly "expression"): writing, audio, video or photo, at a date and time,
/// optionally with people. `date` is kept for older entries; `occurredAt` is the real time.
model Expression {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  date           DateTime           @db.Date
  occurredAt     DateTime?
  kind           String
  body           String
  place          String?
  stamps         Json?
  lookBackOn     DateTime?          @db.Date
  /// The exact moment to bring it back (newer entries). `lookBackOn` is kept as its local date.
  lookBackAt     DateTime?
  /// When the "coming back" notification went out, so it goes out once.
  lookBackSentAt DateTime?
  refDates       Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
  people         ExpressionPerson[]
  attachments    Attachment[]

  @@index([userId, occurredAt])
  @@index([lookBackAt, lookBackSentAt])
}

model Person {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  relation  String?
  howMet    String?
  birthday  DateTime?          @db.Date
  notes     String?
  photoId   String?            @unique
  photo     Attachment?        @relation("PersonPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @default(now()) @updatedAt
  moments   ExpressionPerson[]

  @@index([userId, name])
}

model ExpressionPerson {
  expressionId String
  personId     String
  expression   Expression @relation(fields: [expressionId], references: [id], onDelete: Cascade)
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([expressionId, personId])
  @@index([personId])
}

/// A stored file. `storage` is "blob" (Vercel Blob, private) or "local" (dev only).
model Attachment {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  expressionId String?
  expression   Expression? @relation(fields: [expressionId], references: [id], onDelete: Cascade)
  kind         String
  storage      String
  pathname     String      @unique
  contentType  String
  size         Int
  durationSec  Float?
  createdAt    DateTime    @default(now())
  personPhoto  Person?     @relation("PersonPhoto")
  userPhoto    User?       @relation("UserPhoto")

  @@index([userId])
  @@index([expressionId])
}

/// A letter of commitment to oneself, not tied to any program. Rewriting keeps the old ones.
model Commitment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body         String
  /// "monthly" | "quarterly" | "never"
  revisit      String    @default("monthly")
  revisitedAt  DateTime?
  /// Last time a "read it again" notification was sent.
  remindedAt   DateTime?
  createdAt    DateTime  @default(now())
  supersededAt DateTime?

  @@index([userId, createdAt])
}

/// A browser/device that asked for notifications (Web Push). One person can have several.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

/// The bell: things that came up for someone (a moment back, the letter, a birthday, an
/// approval waiting). Each ends on its own: `expiresAt`, or once read for a week, or when
/// what it was about is resolved.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "moment" | "commitment" | "birthday" | "approval" | "portrait"
  kind      String
  title     String
  body      String
  url       String
  /// One notification per thing (e.g. "moment:<id>:<time>"), so repeats are ignored.
  key       String
  readAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@unique([userId, key])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// "Who am I?": a slow self-portrait in three rings (body, mind, emotion). Each time it is
/// looked at again a new one is kept, so earlier portraits can be set beside today's.
model Portrait {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyWords    String[]
  bodyNote     String?
  mindWords    String[]
  mindNote     String?
  emotionWords String[]
  emotionNote  String?
  /// Weights (-1 heavy … 1 light) for words the person added themselves, e.g. {"homesick": -0.6}.
  weights      Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
